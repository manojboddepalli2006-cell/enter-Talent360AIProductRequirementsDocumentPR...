-- Talent360 AI :: Migration 2 - recruitment, interviews, performance, risk

create table public.talent_job_postings (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.talent_orgs(id) on delete cascade,
  title text not null,
  description text not null default '',
  department_id uuid references public.talent_departments(id) on delete set null,
  seniority text,
  location text,
  employment_type text not null default 'Full-time',
  required_skills text[] not null default '{}',
  status text not null default 'open',
  created_by uuid references public.talent_profiles(id) on delete set null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table public.talent_candidates (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.talent_orgs(id) on delete cascade,
  full_name text not null,
  email text,
  phone text,
  location text,
  source text not null default 'Direct',
  resume_file_url text,
  resume_text text,
  parsed_profile jsonb,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table public.talent_applications (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.talent_orgs(id) on delete cascade,
  candidate_id uuid not null references public.talent_candidates(id) on delete cascade,
  job_posting_id uuid not null references public.talent_job_postings(id) on delete cascade,
  stage text not null default 'sourced',
  ai_match_score numeric,
  ai_match_breakdown jsonb,
  bias_flags jsonb,
  status text not null default 'active',
  decided_by uuid references public.talent_profiles(id) on delete set null,
  decided_at timestamptz,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  constraint talent_applications_stage_check check (stage in ('sourced','screened','interviewing','offer','hired','rejected','hold'))
);

create table public.talent_interviews (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.talent_orgs(id) on delete cascade,
  application_id uuid not null references public.talent_applications(id) on delete cascade,
  interview_type text not null default 'technical',
  scheduled_at timestamptz,
  status text not null default 'scheduled',
  interviewer_id uuid references public.talent_profiles(id) on delete set null,
  overall_score numeric,
  summary text,
  requires_human_review boolean not null default true,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table public.talent_interview_questions (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.talent_orgs(id) on delete cascade,
  interview_id uuid not null references public.talent_interviews(id) on delete cascade,
  position integer not null default 0,
  question_text text not null,
  category text not null default 'technical',
  rubric text,
  created_at timestamptz not null default now()
);

create table public.talent_interview_responses (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.talent_orgs(id) on delete cascade,
  question_id uuid not null references public.talent_interview_questions(id) on delete cascade,
  response_text text not null default '',
  ai_score jsonb,
  score numeric,
  created_at timestamptz not null default now()
);

create table public.talent_performance_reviews (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.talent_orgs(id) on delete cascade,
  employee_id uuid not null references public.talent_employees(id) on delete cascade,
  period text not null,
  score numeric,
  feedback_text text,
  reviewer_id uuid references public.talent_profiles(id) on delete set null,
  created_at timestamptz not null default now()
);

create table public.talent_engagement_signals (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.talent_orgs(id) on delete cascade,
  employee_id uuid not null references public.talent_employees(id) on delete cascade,
  source text not null default 'pulse-survey',
  value numeric not null,
  recorded_at timestamptz not null default now()
);

create table public.talent_risk_assessments (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.talent_orgs(id) on delete cascade,
  employee_id uuid not null references public.talent_employees(id) on delete cascade,
  risk_level text not null default 'low',
  signals jsonb not null default '[]'::jsonb,
  explanation text,
  confidence numeric,
  assessed_at timestamptz not null default now(),
  constraint talent_risk_level_check check (risk_level in ('low','medium','high'))
);

-- --------------------------------------------------------- grants
revoke all on public.talent_job_postings, public.talent_candidates, public.talent_applications,
  public.talent_interviews, public.talent_interview_questions, public.talent_interview_responses,
  public.talent_performance_reviews, public.talent_engagement_signals,
  public.talent_risk_assessments from anon;
grant select, insert, update, delete on public.talent_job_postings, public.talent_candidates,
  public.talent_applications, public.talent_interviews, public.talent_interview_questions,
  public.talent_interview_responses, public.talent_performance_reviews,
  public.talent_engagement_signals, public.talent_risk_assessments to authenticated;

-- ------------------------------------------------------------ RLS

alter table public.talent_job_postings enable row level security;
create policy talent_job_postings_select on public.talent_job_postings for select to authenticated
  using (org_id = public.talent_current_org_id() and public.talent_is_hr());
create policy talent_job_postings_write on public.talent_job_postings for all to authenticated
  using (org_id = public.talent_current_org_id() and public.talent_is_hr())
  with check (org_id = public.talent_current_org_id() and public.talent_is_hr());

alter table public.talent_candidates enable row level security;
create policy talent_candidates_select on public.talent_candidates for select to authenticated
  using (org_id = public.talent_current_org_id() and public.talent_is_hr());
create policy talent_candidates_write on public.talent_candidates for all to authenticated
  using (org_id = public.talent_current_org_id() and public.talent_is_hr())
  with check (org_id = public.talent_current_org_id() and public.talent_is_hr());

alter table public.talent_applications enable row level security;
create policy talent_applications_select on public.talent_applications for select to authenticated
  using (org_id = public.talent_current_org_id() and public.talent_is_hr());
create policy talent_applications_write on public.talent_applications for all to authenticated
  using (org_id = public.talent_current_org_id() and public.talent_is_hr())
  with check (org_id = public.talent_current_org_id() and public.talent_is_hr());

alter table public.talent_interviews enable row level security;
create policy talent_interviews_select on public.talent_interviews for select to authenticated
  using (org_id = public.talent_current_org_id() and (public.talent_is_hr() or interviewer_id = auth.uid()));
create policy talent_interviews_insert on public.talent_interviews for insert to authenticated
  with check (org_id = public.talent_current_org_id() and public.talent_is_hr());
create policy talent_interviews_update on public.talent_interviews for update to authenticated
  using (org_id = public.talent_current_org_id() and (public.talent_is_hr() or interviewer_id = auth.uid()))
  with check (org_id = public.talent_current_org_id() and (public.talent_is_hr() or interviewer_id = auth.uid()));
create policy talent_interviews_delete on public.talent_interviews for delete to authenticated
  using (org_id = public.talent_current_org_id() and public.talent_is_hr());

alter table public.talent_interview_questions enable row level security;
create policy talent_interview_questions_select on public.talent_interview_questions for select to authenticated
  using (org_id = public.talent_current_org_id() and exists (
    select 1 from public.talent_interviews i
    where i.id = interview_id and (public.talent_is_hr() or i.interviewer_id = auth.uid())));
create policy talent_interview_questions_write on public.talent_interview_questions for all to authenticated
  using (org_id = public.talent_current_org_id() and exists (
    select 1 from public.talent_interviews i
    where i.id = interview_id and (public.talent_is_hr() or i.interviewer_id = auth.uid())))
  with check (org_id = public.talent_current_org_id() and exists (
    select 1 from public.talent_interviews i
    where i.id = interview_id and (public.talent_is_hr() or i.interviewer_id = auth.uid())));

alter table public.talent_interview_responses enable row level security;
create policy talent_interview_responses_select on public.talent_interview_responses for select to authenticated
  using (org_id = public.talent_current_org_id() and exists (
    select 1 from public.talent_interview_questions q
    join public.talent_interviews i on i.id = q.interview_id
    where q.id = question_id and (public.talent_is_hr() or i.interviewer_id = auth.uid())));
create policy talent_interview_responses_write on public.talent_interview_responses for all to authenticated
  using (org_id = public.talent_current_org_id() and exists (
    select 1 from public.talent_interview_questions q
    join public.talent_interviews i on i.id = q.interview_id
    where q.id = question_id and (public.talent_is_hr() or i.interviewer_id = auth.uid())))
  with check (org_id = public.talent_current_org_id() and exists (
    select 1 from public.talent_interview_questions q
    join public.talent_interviews i on i.id = q.interview_id
    where q.id = question_id and (public.talent_is_hr() or i.interviewer_id = auth.uid())));

alter table public.talent_performance_reviews enable row level security;
create policy talent_performance_select on public.talent_performance_reviews for select to authenticated
  using (org_id = public.talent_current_org_id() and public.talent_can_view_employee(employee_id));
create policy talent_performance_write on public.talent_performance_reviews for all to authenticated
  using (org_id = public.talent_current_org_id()
    and (public.talent_is_hr() or public.talent_is_manager_of(employee_id)))
  with check (org_id = public.talent_current_org_id()
    and (public.talent_is_hr() or public.talent_is_manager_of(employee_id)));

alter table public.talent_engagement_signals enable row level security;
create policy talent_engagement_select on public.talent_engagement_signals for select to authenticated
  using (org_id = public.talent_current_org_id() and public.talent_can_view_employee(employee_id));
create policy talent_engagement_write on public.talent_engagement_signals for all to authenticated
  using (org_id = public.talent_current_org_id()
    and (public.talent_is_hr() or public.talent_is_manager_of(employee_id)))
  with check (org_id = public.talent_current_org_id()
    and (public.talent_is_hr() or public.talent_is_manager_of(employee_id)));

-- Risk assessments: human resources and the employee's own manager only.
-- The employee themself is deliberately excluded.
alter table public.talent_risk_assessments enable row level security;
create policy talent_risk_select on public.talent_risk_assessments for select to authenticated
  using (org_id = public.talent_current_org_id()
    and (public.talent_is_hr() or public.talent_is_manager_of(employee_id)));
create policy talent_risk_write on public.talent_risk_assessments for all to authenticated
  using (org_id = public.talent_current_org_id() and public.talent_is_hr())
  with check (org_id = public.talent_current_org_id() and public.talent_is_hr());

-- ---------------------------------------------------------- indexes
create index talent_job_postings_org_idx on public.talent_job_postings(org_id);
create index talent_candidates_org_idx on public.talent_candidates(org_id);
create index talent_applications_org_idx on public.talent_applications(org_id, stage);
create index talent_applications_candidate_idx on public.talent_applications(candidate_id);
create index talent_interviews_org_idx on public.talent_interviews(org_id);
create index talent_interviews_application_idx on public.talent_interviews(application_id);
create index talent_interview_questions_interview_idx on public.talent_interview_questions(interview_id);
create index talent_interview_responses_question_idx on public.talent_interview_responses(question_id);
create index talent_performance_employee_idx on public.talent_performance_reviews(employee_id);
create index talent_engagement_employee_idx on public.talent_engagement_signals(employee_id, recorded_at);
create index talent_risk_employee_idx on public.talent_risk_assessments(employee_id, assessed_at desc);

create trigger talent_job_postings_touch before update on public.talent_job_postings
  for each row execute function public.talent_touch_updated_at();
create trigger talent_candidates_touch before update on public.talent_candidates
  for each row execute function public.talent_touch_updated_at();
create trigger talent_applications_touch before update on public.talent_applications
  for each row execute function public.talent_touch_updated_at();
create trigger talent_interviews_touch before update on public.talent_interviews
  for each row execute function public.talent_touch_updated_at();