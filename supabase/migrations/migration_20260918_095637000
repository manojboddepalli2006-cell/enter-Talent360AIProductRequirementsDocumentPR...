-- Talent360 AI :: Migration 4 - signup completion helper

create or replace function public.talent_link_employee()
returns uuid language plpgsql security definer set search_path = public, pg_temp as $$
declare
  v_uid uuid := auth.uid();
  v_org uuid;
  v_email text;
  v_name text;
  v_role text;
  v_title text;
  v_emp uuid;
  v_manager uuid;
  v_demo boolean;
begin
  if v_uid is null then raise exception 'not authenticated'; end if;

  select org_id, email, full_name, role, title
    into v_org, v_email, v_name, v_role, v_title
    from public.talent_profiles where id = v_uid;

  if v_org is null then raise exception 'profile not found'; end if;

  select id into v_emp from public.talent_employees
   where org_id = v_org and user_id is null and lower(email) = lower(v_email)
   order by created_at limit 1;

  if v_emp is not null then
    update public.talent_employees
       set user_id = v_uid,
           full_name = coalesce(nullif(v_name, ''), full_name),
           role_title = coalesce(nullif(v_title, ''), role_title)
     where id = v_emp;
    return v_emp;
  end if;

  select id into v_emp from public.talent_employees where user_id = v_uid limit 1;
  if v_emp is not null then return v_emp; end if;

  insert into public.talent_employees
    (org_id, user_id, full_name, email, role_title, seniority, status, hire_date)
  values (
    v_org, v_uid, coalesce(nullif(v_name, ''), 'New Member'), v_email,
    coalesce(nullif(v_title, ''), case v_role
      when 'org_admin' then 'Organization Administrator'
      when 'hr_admin' then 'HR Manager'
      when 'manager' then 'People Manager'
      else 'Team Member' end),
    case v_role
      when 'org_admin' then 'Executive'
      when 'hr_admin' then 'Lead'
      when 'manager' then 'Manager'
      else 'Associate' end,
    'active', current_date)
  returning id into v_emp;

  select is_demo into v_demo from public.talent_orgs where id = v_org;

  if coalesce(v_demo, false) then
    if v_role = 'employee' then
      select id into v_manager from public.talent_employees
        where org_id = v_org and lower(email) = 'manager@talent360.demo' limit 1;
    elsif v_role = 'hr_admin' then
      select id into v_manager from public.talent_employees
        where org_id = v_org and lower(email) = 'admin@talent360.demo' limit 1;
    end if;
    if v_manager is not null then
      update public.talent_employees set manager_id = v_manager where id = v_emp;
    end if;
  end if;

  return v_emp;
end; $$;

grant execute on function public.talent_link_employee() to authenticated;
grant execute on function public.talent_demo_workspace_id() to authenticated;
grant execute on function public.talent_search_policy_chunks(text, integer) to authenticated;