-- ------------------------------------------------ workflow guard trigger
create or replace function public.talent_enforce_workflow_approval()
returns trigger language plpgsql security definer set search_path = public, pg_temp as $$
declare st text;
begin
  select status into st from public.talent_ai_recommendations where id = new.recommendation_id;
  if st is null then
    raise exception 'recommendation % does not exist', new.recommendation_id;
  end if;
  if st not in ('approved','modified') then
    raise exception 'a workflow cannot exist without an approved recommendation (status=%)', st;
  end if;
  return new;
end; $$;

create trigger talent_workflows_require_approval
  before insert or update on public.talent_workflows
  for each row execute function public.talent_enforce_workflow_approval();

-- ------------------------------------------- policy retrieval (RAG-lite)
create or replace function public.talent_search_policy_chunks(query_text text, match_count integer default 6)
returns table (chunk_id uuid, document_id uuid, document_title text, section text, chunk_text text, rank real)
language sql stable security definer set search_path = public, pg_temp as $$
  with q as (select websearch_to_tsquery('english', coalesce(nullif(trim(query_text), ''), 'policy')) as tsq)
  select c.id, c.document_id, d.title, c.section, c.chunk_text,
         ts_rank(c.search_vector, q.tsq)::real as rank
  from public.talent_policy_chunks c
  join public.talent_policy_documents d on d.id = c.document_id
  cross join q
  where c.org_id = public.talent_current_org_id()
    and c.search_vector @@ q.tsq
  order by rank desc
  limit greatest(1, least(coalesce(match_count, 6), 20));
$$;

