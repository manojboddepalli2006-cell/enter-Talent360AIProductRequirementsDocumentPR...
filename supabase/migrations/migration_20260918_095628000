-- Talent360 AI :: Migration 3 - AI recommendations, workflows, policies, onboarding, governance

create table public.talent_ai_recommendations (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.talent_orgs(id) on delete cascade,
  module text not null,
  entity_type text not null default 'employee',
  entity_id uuid,
  employee_id uuid references public.talent_employees(id) on delete cascade,
  application_id uuid references public.talent_applications(id) on delete cascade,
  title text not null,
  summary text,
  recommendation jsonb not null default '{}'::jsonb,
  status text not null default 'pending',
  reviewed_by uuid references public.talent_profiles(id) on delete set null,
  reviewed_at timestamptz,
  rejection_reason text,
  modified_payload jsonb,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  constraint talent_ai_rec_module_check check (module in ('recruit','interview','develop','monitor','onboard')),
  constraint talent_ai_rec_status_check check (status in ('pending','approved','modified','rejected'))
);

create table public.talent_workflows (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.talent_orgs(id) on delete cascade,
  recommendation_id uuid not null unique references public.talent_ai_recommendations(id) on delete cascade,
  workflow_type text not null default 'check-in',
  status text not null default 'active',
  created_by uuid references public.talent_profiles(id) on delete set null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table public.talent_workflow_tasks (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.talent_orgs(id) on delete cascade,
  workflow_id uuid not null references public.talent_workflows(id) on delete cascade,
  assignee_employee_id uuid references public.talent_employees(id) on delete set null,
  assignee_name text,
  title text not null,
  description text,
  due_date date,
  status text not null default 'open',
  completed_at timestamptz,
  created_at timestamptz not null default now()
);

create table public.talent_outcomes (
  id uuid primary key default gen_random_uuid(),
  org_id uuid not null references public.talent_orgs(id) on delete cascade,
  workflow_id uuid not null references public.talent_workflows(id) on delete cascade,
  measured_at timestamptz not null default now(),
  metric text not null,
  before_value numeric,
  after_value numeric,
